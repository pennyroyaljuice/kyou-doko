{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyou-doko",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "LIVE_SEARCH_ENABLED": "true",
    "ADMIN_AUTH_MODE": "google",
    "PUBLIC_SEARCH_ENABLED": "false"
  },
  "assets": {
    "run_worker_first": [
      "/admin*",
      "/api/*",
      "/setup",
      "/login",
      "/logout"
    ]
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1847351026",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "PHOTO_LIMITER",
      "namespace_id": "1847351027",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE_BUDGET",
        "class_name": "UsageBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "usage-v1",
      "new_sqlite_classes": [
        "UsageBudget"
      ]
    }
  ]
}
