{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyou-doko",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "LIVE_SEARCH_ENABLED": "true"
  },
  "assets": {
    "run_worker_first": [
      "/admin*",
      "/api/*",
      "/setup"
    ]
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1847351026",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
